# Copy this file to .env and fill in your values. .env is gitignored — never commit keys.
ELEVENLABS_API_KEY=
# Model: eleven_multilingual_v2 is stable; eleven_v3 is more expressive.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# One voice per speaker. Find Voice IDs in ElevenLabs > Voices > (voice) > "ID".
VOICE_EXECUTOR=
VOICE_JONAH=
VOICE_GRANDMA=
VOICE_MRS_BELLO=
VOICE_KEMI=
VOICE_TUNDE=
VOICE_CUSTOMER=
VOICE_PASSENGER=
VOICE_IYA=
VOICE_MAGS=
VOICE_KADE=
VOICE_ANCHOR=
VOICE_CAPTAIN=
VOICE_FISHERMAN=
VOICE_ASSISTANT=
# Borrowed Day
VOICE_NARRATOR=
VOICE_RICHEST=
VOICE_MARCUS=
VOICE_ADA=
VOICE_FRIEND=
VOICE_PRESIDENT=
VOICE_MAMA=
VOICE_SISTER=
VOICE_YOU=
