# Copy this file to .env and fill in your values. .env is gitignored — never commit keys.
ELEVENLABS_API_KEY=
# Model: eleven_multilingual_v2 is stable; eleven_v3 is more expressive.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# One voice per speaker. Find Voice IDs in ElevenLabs > Voices > (voice) > "ID".
VOICE_EXECUTOR=
VOICE_JONAH=
VOICE_GRANDMA=
VOICE_MRS_BELLO=
VOICE_KADE=
VOICE_ANCHOR=
VOICE_CAPTAIN=
VOICE_FISHERMAN=
VOICE_ASSISTANT=
